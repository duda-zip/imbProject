@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

:root{
  --background:#fff;--foreground:#16223f;--card:#fff;--muted:#f5f7fa;--muted-text:#68758a;
  --primary:#0E1B45;--primary-dark:#081029;--navy:#0E1B45;--gold:#F5B400;--gold-dark:#B37D00;--border:#e4e9f1;
  --radius:18px;--shadow:0 8px 28px rgba(14,27,69,.07);--shadow-lift:0 20px 45px rgba(14,27,69,.13);
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--foreground);background:var(--background);font-family:'Plus Jakarta Sans',Arial,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}img{max-width:100%;display:block}.container{width:min(1200px,calc(100% - 40px));margin:auto}
.navbar{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(255,255,255,.45);backdrop-filter:blur(12px);border-bottom:1px solid transparent;transition:.35s}
.navbar.scrolled{background:rgba(255,255,255,.9);border-color:var(--border);box-shadow:var(--shadow)}
.nav-container{height:80px;width:min(1200px,calc(100% - 40px));margin:auto;display:flex;align-items:center;justify-content:space-between;gap:20px;transition:.35s}
.navbar.scrolled .nav-container{height:64px}.logo{display:flex;align-items:center;gap:10px;font-weight:800}.logo-mark{display:block;width:42px;height:42px;border-radius:50%;object-fit:cover;flex-shrink:0}.logo-text{font-size:16px}
.desktop-nav{display:flex;align-items:center;gap:5px}.desktop-nav>a:not(.btn){padding:9px 14px;color:var(--muted-text);font-size:14px;font-weight:600}.desktop-nav>a:not(.btn):hover{color:var(--foreground)}
.nav-actions{gap:8px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:11px;padding:10px 17px;font-weight:700;font-size:14px;border:1px solid transparent;cursor:pointer;transition:.25s}.btn-primary{background:var(--primary);color:#fff}.btn-primary:hover{background:var(--primary-dark);transform:translateY(-1px)}.btn-outline{border-color:var(--border);background:#fff;color:var(--foreground)}.btn-outline:hover{border-color:rgba(14,27,69,.35);color:var(--primary)}.btn-ghost{background:transparent}.btn-ghost:hover{background:var(--muted)}.btn-white{background:#fff;color:var(--primary)}.btn-large{padding:13px 20px;font-size:15px}.menu-button{display:none;background:#fff;border:1px solid var(--border);border-radius:11px;width:42px;height:42px;font-size:20px}.mobile-menu{display:none}

.hero{position:relative;overflow:hidden;padding:155px 0 105px;background:radial-gradient(60rem 40rem at 85% -10%,rgba(14,27,69,.10),transparent 70%),radial-gradient(50rem 35rem at 0% 10%,rgba(14,27,69,.06),transparent 70%),linear-gradient(180deg,#fff,#f6f7fb)}
.grid-overlay{position:absolute;inset:0;opacity:.35;background-image:linear-gradient(to right,#e4e9f1 1px,transparent 1px),linear-gradient(to bottom,#e4e9f1 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000 40%,transparent 100%)}
.hero-grid{position:relative;display:grid;grid-template-columns:1.05fr 1fr;gap:45px;align-items:center}.hero-content{max-width:640px}.eyebrow,.section-eyebrow{display:inline-flex;align-items:center;color:var(--primary);font-size:12px;font-weight:800;letter-spacing:.02em;text-transform:uppercase}.eyebrow{padding:7px 13px;border:1px solid rgba(14,27,69,.15);border-radius:999px;background:rgba(255,255,255,.75);text-transform:none;font-size:12px}
h1,h2,h3{letter-spacing:-.035em;line-height:1.12;margin:0}h1{font-size:clamp(42px,5vw,68px);margin-top:23px;font-weight:800}h1 span{display:block;background:linear-gradient(90deg,var(--navy),var(--gold-dark));-webkit-background-clip:text;background-clip:text;color:transparent}h2{font-size:clamp(30px,4vw,46px);font-weight:800}h3{font-size:18px}
.hero-content>p{max-width:600px;margin:25px 0 0;color:var(--muted-text);font-size:17px}.hero-buttons{display:flex;gap:12px;margin-top:34px}.hero-features{display:flex;flex-wrap:wrap;gap:25px;margin-top:30px;color:var(--muted-text);font-size:13px;font-weight:600}.hero-features span:first-child,.hero-features span:last-child{color:var(--gold-dark)}
.hero-image-wrap{position:relative;max-width:590px;margin:auto}.hero-glow{position:absolute;inset:-25px;border-radius:48px;background:radial-gradient(circle at 50% 50%,rgba(245,180,0,.18),transparent 65%);filter:blur(25px)}.hero-image-wrap img{position:relative;width:100%}.floating-card{position:absolute;background:rgba(255,255,255,.95);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow-lift);backdrop-filter:blur(10px);padding:13px 16px;animation:float 6s ease-in-out infinite}.floating-card small{display:block;color:var(--muted-text);font-size:10px}.floating-card strong{display:block;font-size:18px}.progress-card{left:-5px;top:8%}.progress{width:110px;height:6px;border-radius:999px;background:#edf0f5;margin-top:6px;overflow:hidden}.progress span{display:block;width:78%;height:100%;background:var(--primary);border-radius:inherit}.certificate-card{right:-4px;bottom:9%;display:flex;align-items:center;gap:10px}.certificate-icon{width:35px;height:35px;display:grid;place-items:center;border-radius:10px;background:rgba(245,180,0,.15);color:var(--gold-dark);font-weight:900}
@keyframes float{50%{transform:translateY(-12px)}}

.stats-section{border-block:1px solid var(--border);background:#fff}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr)}.stat{text-align:center;padding:27px 10px;border-right:1px solid var(--border)}.stat:last-child{border:0}.stat strong{display:block;font-size:27px;color:var(--primary)}.stat span{font-size:12px;color:var(--muted-text);font-weight:600}
.section{padding:105px 0}.section-muted{background:rgba(245,247,250,.7);border-block:1px solid var(--border)}.about-grid,.benefits-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:75px}.about-image img,.benefits-image img{width:100%}.section-content>p,.benefits-content>p{color:var(--muted-text);font-size:16px;margin:22px 0 0;max-width:560px}.pillars{margin-top:28px;display:grid;gap:18px}.pillars>div{display:flex;gap:14px;align-items:flex-start}.pillars>div>span{color:var(--primary);font-weight:800;font-size:12px;background:#FFF3D6;padding:6px 9px;border-radius:8px}.pillars h3{font-size:15px}.pillars p{margin:3px 0 0;color:var(--muted-text);font-size:13px}.section-heading{max-width:720px;margin:auto;text-align:center}.section-heading p{color:var(--muted-text);margin:15px auto 0;max-width:650px}.sobre-extra{margin-top:80px}.features-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px;margin-top:50px}.feature-card,.testimonial,.course-card,.blog-card{background:var(--card);border:1px solid var(--border);border-radius:20px;box-shadow:var(--shadow);transition:.35s}.feature-card{padding:24px}.feature-card:hover,.course-card:hover,.blog-card:hover,.testimonial:hover{transform:translateY(-5px);box-shadow:var(--shadow-lift);border-color:rgba(14,27,69,.2)}.feature-icon{width:42px;height:42px;display:grid;place-items:center;background:#FFF3D6;color:var(--primary);border-radius:12px;font-weight:800;margin-bottom:18px}.feature-card h3{font-size:16px}.feature-card p{font-size:13px;color:var(--muted-text);margin:8px 0 0}
.courses-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:50px}.course-card{overflow:hidden;display:flex;flex-direction:column}.course-image{position:relative;aspect-ratio:16/10;overflow:hidden}.course-image img{width:100%;height:100%;object-fit:cover;transition:.7s}.course-card:hover .course-image img{transform:scale(1.05)}.status{position:absolute;top:15px;left:15px;padding:6px 11px;border-radius:999px;background:rgba(255,255,255,.9);font-size:11px;font-weight:800;color:var(--muted-text)}.status.available{background:var(--gold);color:var(--navy)}.course-body{padding:22px;display:flex;flex-direction:column;flex:1}.module{font-size:11px;color:var(--muted-text);font-weight:700}.course-body h3{margin-top:11px;font-size:18px}.course-body p{color:var(--muted-text);font-size:13px;line-height:1.7;flex:1;margin:8px 0 20px}.course-body .btn{align-self:flex-start}
.benefits-section{background:linear-gradient(135deg,#0E1B45,#1F3585);color:#fff}.benefits-section .section-eyebrow{color:var(--gold)}.benefits-content>p{color:rgba(255,255,255,.72)}.benefits-list{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px}.benefits-list span{font-size:13px;font-weight:700;color:rgba(255,255,255,.9)}
.testimonials-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:50px}.testimonial{padding:25px}.stars{color:var(--gold);letter-spacing:2px}.testimonial p{color:var(--muted-text);font-size:14px;line-height:1.8;margin:17px 0}.testimonial strong{display:block;font-size:14px}.testimonial span{font-size:11px;color:var(--muted-text)}
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:50px}.blog-card{overflow:hidden}.blog-card img{width:100%;aspect-ratio:16/9;object-fit:cover}.blog-body{padding:22px}.blog-body>span{font-size:10px;color:var(--primary);font-weight:800}.blog-body h3{font-size:17px;margin-top:10px}.blog-body p{font-size:13px;color:var(--muted-text);margin:9px 0 16px}.blog-body a{font-size:13px;font-weight:800;color:var(--primary)}
.faq-container{max-width:850px}.faq-list{margin-top:45px}.faq-item{border-bottom:1px solid var(--border)}.faq-question{width:100%;border:0;background:none;padding:20px 0;display:flex;justify-content:space-between;align-items:center;text-align:left;font:700 15px 'Plus Jakarta Sans';color:var(--foreground);cursor:pointer}.faq-question b{font-size:22px;color:var(--primary);font-weight:500}.faq-answer{display:grid;grid-template-rows:0fr;transition:.3s}.faq-answer p{overflow:hidden;margin:0;color:var(--muted-text);font-size:13px}.faq-item.open .faq-answer{grid-template-rows:1fr}.faq-item.open .faq-answer p{padding:0 0 20px}.faq-item.open .faq-question b{transform:rotate(45deg)}
.cta-section{padding:90px 0;background:radial-gradient(40rem 28rem at 15% 0%,rgba(245,180,0,.35),transparent 70%),linear-gradient(135deg,#0E1B45,#1F3585);color:#fff;text-align:center}.cta-content{max-width:700px}.section-eyebrow.light{color:var(--gold)}.cta-content h2{margin-top:13px}.cta-content p{color:rgba(255,255,255,.75);margin:15px 0 28px}
.footer{background:#f7f8fa;border-top:1px solid var(--border)}.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:45px;padding:70px 0}.footer p,.footer a{font-size:13px;color:var(--muted-text)}.footer-grid>div>p{max-width:380px;margin-top:18px}.footer h3{font-size:14px;margin-bottom:15px}.footer-grid>div>a:not(.logo){display:block;margin:9px 0}.footer a:hover{color:var(--primary)}.footer-logo{color:var(--foreground)!important}.socials{display:flex;gap:12px;margin-top:20px}.socials a{padding:8px 11px;border:1px solid var(--border);border-radius:9px;background:#fff}.footer-bottom{border-top:1px solid var(--border)}.footer-bottom .container{display:flex;justify-content:space-between;gap:20px;padding:22px 0}.footer-bottom span{font-size:10px;color:var(--muted-text)}
.reveal{opacity:0;transform:translateY(20px);transition:.7s cubic-bezier(.22,1,.36,1)}.reveal.visible{opacity:1;transform:none}

@media(max-width:1000px){.desktop-nav{display:none}.menu-button{display:block}.mobile-menu{overflow:hidden;max-height:0;opacity:0;background:rgba(255,255,255,.97);border-top:1px solid var(--border);transition:.35s;padding:0 20px}.mobile-menu.open{max-height:500px;opacity:1;padding:15px 20px}.mobile-menu>a{display:block;padding:11px 5px;color:var(--muted-text);font-weight:600}.mobile-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}.hero-grid{grid-template-columns:1fr}.hero-content{max-width:760px}.hero-image-wrap{max-width:650px}.features-grid{grid-template-columns:repeat(2,1fr)}.courses-grid{grid-template-columns:repeat(2,1fr)}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}}
@media(max-width:650px){.container,.nav-container{width:min(100% - 28px,1200px)}.hero{padding:130px 0 70px}.hero-buttons{flex-direction:column}.hero-buttons .btn{width:100%}.hero-features{display:grid;gap:8px}.floating-card{display:none}.stats-grid{grid-template-columns:1fr 1fr}.stat{border-bottom:1px solid var(--border)}.stat:nth-child(2){border-right:0}.section{padding:72px 0}.about-grid,.benefits-grid{grid-template-columns:1fr;gap:35px}.about-image{order:2}.features-grid,.courses-grid,.testimonials-grid,.blog-grid{grid-template-columns:1fr}.benefits-list{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr}.footer-grid>div:first-child{grid-column:auto}.footer-bottom .container{flex-direction:column}}

/* ==========================================================================
   Telas de autenticação (Login / Cadastro)
   ========================================================================== */
.auth-body{margin:0}
.auth-screen{position:relative;min-height:100vh;display:grid;grid-template-columns:1fr 1fr}
.auth-panel{position:relative;display:flex;flex-direction:column;justify-content:space-between;gap:40px;padding:48px;background:radial-gradient(circle at 85% 15%,rgba(245,180,0,.22),transparent 45%),linear-gradient(165deg,#1F3585,#0E1B45 65%);color:#fff;overflow:hidden}
.auth-panel::after{content:"";position:absolute;left:-20%;bottom:-30%;width:140%;height:60%;background:radial-gradient(ellipse at center,var(--gold) 0%,transparent 68%);opacity:.16;pointer-events:none}
.auth-brand{display:flex;align-items:center;gap:10px;z-index:1;font-weight:800}
.auth-brand img{width:42px;height:42px;border-radius:50%;object-fit:cover}
.auth-brand span{color:#fff;font-size:16px}
.auth-panel-copy{z-index:1;max-width:26ch}
.auth-panel-copy h1{color:#fff;font-size:clamp(1.5rem,2.6vw,2rem);line-height:1.2;margin-bottom:24px;letter-spacing:-.03em;font-weight:800}
.auth-checklist{list-style:none;display:flex;flex-direction:column;gap:10px;margin:0;padding:0;font-size:.92rem;font-weight:600}
.auth-checklist li{display:flex;align-items:center;gap:10px}
.auth-checklist li::before{content:"✓";display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:var(--gold);color:var(--navy);font-size:.7rem;font-weight:800;flex-shrink:0}
.auth-quote{z-index:1;margin:0;padding-top:20px;border-top:1px solid rgba(255,255,255,.15);font-style:italic;font-size:1rem;color:rgba(255,255,255,.85)}
.auth-form-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:48px 24px;background:#fff}
.back-link{align-self:flex-start;width:100%;max-width:380px;margin-bottom:14px;font-size:13px;font-weight:700;color:var(--muted-text)}
.back-link:hover{color:var(--primary)}
.auth-form-card{width:100%;max-width:380px}
.auth-form-card h2{font-size:1.6rem;margin-bottom:6px}
.auth-form-sub{font-size:.92rem;color:var(--muted-text);margin-bottom:28px}
.auth-alert{padding:12px 14px;margin-bottom:18px;border-radius:12px;background:#EFF3FF;color:var(--navy);font-size:.85rem;font-weight:600}
.auth-form{display:flex;flex-direction:column}
.auth-form label{font-size:.85rem;font-weight:700;color:var(--foreground);margin-bottom:6px}
.auth-form input[type="email"],.auth-form input[type="password"],.auth-form input[type="text"]{width:100%;padding:12px 14px;margin-bottom:18px;border:1.5px solid var(--border);border-radius:12px;font-size:.94rem;font-family:'Plus Jakarta Sans',Arial,sans-serif;color:var(--foreground);background:#fff;transition:border-color .15s ease}
.auth-form input:focus{outline:none;border-color:var(--primary)}
.password-field{position:relative}
.password-field input{padding-right:44px}
.password-toggle{position:absolute;right:10px;top:50%;transform:translateY(-50%);margin-top:-9px;background:none;border:none;cursor:pointer;font-size:1rem;opacity:.6}
.password-toggle:hover{opacity:1}
.auth-form-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;font-size:.85rem}
.auth-checkbox{display:flex;align-items:center;gap:8px;font-weight:600;color:var(--muted-text);margin-bottom:0;cursor:pointer}
.auth-checkbox input{margin:0}
.auth-link{color:var(--primary);font-weight:700}
.auth-link:hover{text-decoration:underline}
.btn-block{width:100%}
.auth-form-footer{margin:20px 0 0;text-align:center;font-size:.88rem;color:var(--muted-text)}
@media(max-width:900px){.auth-screen{grid-template-columns:1fr}.auth-panel{min-height:260px;padding:36px 28px}.auth-panel-copy{max-width:none}}

/* ==========================================================================
   Página de detalhe do curso (curso.php)
   ========================================================================== */
.course-hero{padding:150px 0 55px;background:linear-gradient(180deg,#fff,#f6f7fb)}
.breadcrumb{font-size:13px;color:var(--muted-text);margin-bottom:20px}
.breadcrumb a{color:var(--muted-text)}
.breadcrumb a:hover{color:var(--primary)}
.course-hero-head{display:flex;flex-wrap:wrap-reverse;gap:32px;justify-content:space-between;align-items:center}
.course-hero-info{max-width:600px;flex:1 1 360px}
.course-hero-info h1{font-size:clamp(32px,4vw,44px);margin:14px 0 14px}
.course-hero-info>p{color:var(--muted-text);font-size:16px}
.course-hero-meta{display:flex;gap:20px;margin-top:18px;font-size:13px;color:var(--muted-text);flex-wrap:wrap}
.course-hero-meta span{display:flex;align-items:center;gap:6px}
.course-hero-actions{margin-top:28px}
.course-hero-image{flex:0 1 340px;border-radius:20px;overflow:hidden;box-shadow:var(--shadow-lift)}
.course-hero-image img{width:100%;display:block}

.section-heading-left{max-width:640px;margin:0 0 32px;text-align:left}
.section-heading-left p{color:var(--muted-text);margin:12px 0 0}

.module-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;max-width:720px}
.module-list li{display:flex;align-items:center;gap:16px;padding:16px 20px;border:1px solid var(--border);border-radius:14px;background:#fff;transition:.25s}
.module-list li:hover{border-color:rgba(14,27,69,.2);box-shadow:var(--shadow)}
.module-number{width:32px;height:32px;flex-shrink:0;display:grid;place-items:center;border-radius:50%;background:#FFF3D6;color:var(--navy);font-weight:800;font-size:13px}
.module-list h3{font-size:15px;margin:0}

.course-empty{max-width:520px;padding:40px;border:1px dashed var(--border);border-radius:20px;text-align:center;background:var(--muted)}
.course-empty h3{margin-bottom:10px}
.course-empty p{color:var(--muted-text);margin-bottom:20px}

@media(max-width:650px){.course-hero{padding:130px 0 40px}.course-hero-head{flex-direction:column;align-items:flex-start}.course-hero-image{flex-basis:auto;width:100%}}
